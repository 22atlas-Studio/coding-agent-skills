# qa/workflows.yaml - workflow inventory for qa-walk
#
# How this file works:
# - First run scaffolds this from your project's SCOPE.md / TASKS.md / Obsidian docs.
# - The operator reviews + edits + commits. Future runs use the locked file.
# - Only `regression_checks` mutates between runs (append-only). Every BUG verdict
#   adds one line so future runs check for it explicitly.
#
# Schema validated by helpers/validate_workflows.py.

app: <app-id>           # required, e.g. "example-app"
last_scaffold: "2026-05-10"   # quote so PyYAML doesn't auto-coerce to datetime.date

workflows:
  - id: customer-appointment-book                        # required, kebab-case, unique
    name: Customer books an appointment                  # required, human readable
    persona: customer                                    # required, must match an entry in auth.yaml
    entry_route: /appointments/book/{slot_id}            # required, supports {placeholder}
    test_data:
      slot_id: from-fixture                              # placeholder values resolved from qa/fixtures.yaml
    definition_of_done: |
      Customer sees an open time slot on the booking page, clicks Book,
      appointment status flips from AVAILABLE to BOOKED, the badge updates
      without a hard reload, POST /api/notifications fires once, and zero
      console errors appear in the page lifecycle.
    do_not_change: |
      Don't navigate away from this slot. Don't touch other appointments.
      Don't modify account profile settings.
    regression_checks: []                                # append-only; populated by future runs
