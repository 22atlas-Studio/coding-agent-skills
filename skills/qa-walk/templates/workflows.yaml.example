# qa/workflows.yaml - workflow inventory for qa-walk
#
# How this file works:
# - First run scaffolds this from your project's SCOPE.md / TASKS.md / Obsidian docs.
# - Sean reviews + edits + commits. Future runs use the locked file.
# - Only `regression_checks` mutates between runs (append-only). Every BUG verdict
#   adds one line so future runs check for it explicitly.
#
# Schema validated by helpers/validate_workflows.py.

app: <app-id>           # required, e.g. "example-app"
last_scaffold: "2026-05-10"   # quote so PyYAML doesn't auto-coerce to datetime.date

workflows:
  - id: dealer-offer-accept                              # required, kebab-case, unique
    name: Dealer accepts customer offer                  # required, human readable
    persona: dealer                                      # required, must match an entry in auth.yaml
    entry_route: /dealer/deals/{deal_id}                 # required, supports {placeholder}
    test_data:
      deal_id: from-fixture                              # placeholder values resolved from fixtures (see qa/fixtures.yaml; deferred to Task 18)
    definition_of_done: |
      Dealer sees incoming customer offer on the deal page, clicks Accept,
      deal status flips from OFFER_PENDING to ACCEPTED, the badge updates
      without a hard reload, POST /api/notifications fires once, and zero
      console errors appear in the page lifecycle.
    do_not_change: |
      Don't navigate away from this deal. Don't touch other deals.
      Don't modify dealer profile settings.
    regression_checks: []                                # append-only; populated by future runs
