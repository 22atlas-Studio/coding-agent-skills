# qa/auth.yaml - persona credentials and login strategies for qa-walk
#
# Passwords NEVER live in this file. Reference env-var names only;
# values come from .env or shell. helpers/validate_auth.py rejects
# yaml that inlines a password.

personas:
  customer:
    email: customer@test.<app>.local
    password_env: QA_CUSTOMER_PASSWORD                   # value from .env
    login:
      type: email_password                               # email_password | magic_link | anonymous_then_upgrade
      route: /login
      success_marker: "Welcome,"                         # text expected on landing page after login
    bypass:                                              # optional, runs once before login
      type: sql                                          # sql | http | none
      # `command` is shell-passthrough - runner must invoke via `subprocess.run(cmd, shell=True)` or `bash -c`,
      # NOT `shlex.split()` or argv list, or the literal `\"` escape sequences will leak through to Postgres.
      command: docker exec <pg-container> psql -U <user> -d <db> -c "UPDATE \"User\" SET \"isEmailVerified\"=true WHERE email='customer@test.<app>.local'"

  staff:
    email: staff@test.<app>.local
    password_env: QA_STAFF_PASSWORD
    login:
      type: magic_link
      mailbox_url: http://localhost:54324                # Supabase local Inbucket
      success_marker: "Schedule"
